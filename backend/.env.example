DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/bankshield_ai
JWT_SECRET=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
ML_MODEL_PATH=/absolute/path/to/ml/fraud_model.pkl

# Optional real email alerts / password-reset email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-alert-mail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-alert-mail@gmail.com
SMTP_TLS=1

# Optional real SMS alerts through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional banker emails (all use the local-demo password Neeraj@123 until changed)
BANKER_1_EMAIL=banker1@bankshield.ai
BANKER_2_EMAIL=banker2@bankshield.ai
BANKER_3_EMAIL=banker3@bankshield.ai
BANKER_4_EMAIL=banker4@bankshield.ai


# Real customer fraud notifications (optional)
# Gmail: use an App Password, not your normal account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=yourbankshield@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=yourbankshield@gmail.com
